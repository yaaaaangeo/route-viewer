{
  "name": "route-viewer",
  "productName": "Route Viewer",
  "version": "3.1.2",
  "description": "nav-app 주행기록 리플레이 · 누적 지도 · 통계 데스크톱 앱",
  "main": "electron/main.js",
  "author": "route-viewer",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "serve": "node server.js",
    "dist": "electron-builder --win nsis portable --publish never",
    "pack": "electron-builder --win --dir",
    "test": "node tests/run-tests.js && node tests/coverage-grid-test.js && node tests/coverage-gap-healing-test.js && node tests/apartment-shinhyundai-test.js && node tests/apartment-eunma-test.js && node tests/hdmap-data-test.js && node tests/manual-cells-storage-test.js && node tests/coverage-manual-cells-test.js && node tests/accum-date-filter-test.js && node tests/map-capture-test.js && node tests/collection-progress-test.js",
    "test:e2e": "electron . --enable-logging",
    "test:browser-capture": "electron tests/browser-capture-e2e.js"
  },
  "dependencies": {
    "node-sqlite3-wasm": "^0.8.45",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^25.1.8",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.navapp.routeviewer",
    "productName": "Route Viewer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "vendor/**/*",
      "package.json",
      "node_modules/node-sqlite3-wasm/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-sqlite3-wasm/dist/*.wasm"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "http://localhost:8080/updates",
        "channel": "latest"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "RouteViewer-${version}-${os}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "RouteViewer-portable-${version}-${arch}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Route Viewer",
      "installerLanguages": [
        "ko-KR",
        "en-US"
      ],
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
